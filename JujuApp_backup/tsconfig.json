{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "**/__tests__/**"]
}
