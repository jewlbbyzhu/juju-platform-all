<view class="ticket-inventory-container data-v-d138348d"><view class="header data-v-d138348d"><text class="header-title data-v-d138348d">票型库存管理</text><text class="header-subtitle data-v-d138348d">管理票型库存和销售情况</text></view><view class="filter-bar data-v-d138348d"><view class="filter-item data-v-d138348d"><text class="filter-label data-v-d138348d">状态筛选</text><picker class="data-v-d138348d" mode="selector" range="{{b}}" bindchange="{{c}}"><view class="picker-input data-v-d138348d"><text class="picker-text data-v-d138348d">{{a}}</text><text class="picker-arrow data-v-d138348d">›</text></view></picker></view><view class="filter-item data-v-d138348d"><text class="filter-label data-v-d138348d">搜索</text><input class="search-input data-v-d138348d" placeholder="搜索票型名称..." bindinput="{{d}}" value="{{e}}"/></view></view><scroll-view class="inventory-list data-v-d138348d" scroll-y bindscrolltolower="{{j}}"><view wx:for="{{f}}" wx:for-item="item" wx:key="t" class="inventory-item data-v-d138348d"><view class="item-header data-v-d138348d"><view class="item-info data-v-d138348d"><text class="item-name data-v-d138348d">{{item.a}}</text><text class="item-type data-v-d138348d">{{item.b}}</text><text wx:if="{{item.c}}" class="item-party data-v-d138348d">{{item.d}}</text></view><view class="item-status data-v-d138348d"><text class="{{['status-badge', 'data-v-d138348d', item.f]}}">{{item.e}}</text></view></view><view class="item-details data-v-d138348d"><view class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">价格</text><text class="detail-value data-v-d138348d">¥{{item.g}}</text></view><view class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">原价</text><text class="detail-value data-v-d138348d">¥{{item.h}}</text></view><view class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">可用库存</text><text class="detail-value data-v-d138348d">{{item.i}}</text></view><view class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">已售数量</text><text class="detail-value data-v-d138348d">{{item.j}}</text></view><view wx:if="{{item.k}}" class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">团购人数</text><text class="detail-value data-v-d138348d">{{item.l}}人起</text></view><view wx:if="{{item.m}}" class="detail-row data-v-d138348d"><text class="detail-label data-v-d138348d">团购折扣</text><text class="detail-value data-v-d138348d">{{item.n}}折</text></view></view><view class="item-actions data-v-d138348d"><button class="action-btn edit data-v-d138348d" bindtap="{{item.o}}"><text class="data-v-d138348d">编辑</text></button><button class="action-btn adjust data-v-d138348d" bindtap="{{item.p}}"><text class="data-v-d138348d">调整库存</text></button><button class="{{['action-btn', 'data-v-d138348d', item.r && 'disable']}}" bindtap="{{item.s}}"><text class="data-v-d138348d">{{item.q}}</text></button></view></view><view wx:if="{{g}}" class="loading-more data-v-d138348d"><text class="data-v-d138348d">加载中...</text></view><view wx:if="{{h}}" class="no-more data-v-d138348d"><text class="data-v-d138348d">没有更多了</text></view><view wx:if="{{i}}" class="empty-state data-v-d138348d"><text class="empty-icon data-v-d138348d">🎫</text><text class="empty-text data-v-d138348d">暂无票型</text><text class="empty-tip data-v-d138348d">创建聚会后可添加票型</text></view></scroll-view><view class="action-bar data-v-d138348d"><button class="action-btn primary data-v-d138348d" bindtap="{{k}}"><text class="data-v-d138348d">+ 新建票型</text></button><button class="action-btn secondary data-v-d138348d" bindtap="{{l}}"><text class="data-v-d138348d">批量调整</text></button></view></view>