<view class="user-profile-container data-v-db2757ab"><view class="header data-v-db2757ab"><text class="header-title data-v-db2757ab">用户画像</text><text class="header-subtitle data-v-db2757ab">完善信息，获得更精准推荐</text></view><view class="profile-section data-v-db2757ab"><view class="section-header data-v-db2757ab"><text class="section-title data-v-db2757ab">🏷️ 兴趣标签</text><text class="section-edit data-v-db2757ab" bindtap="{{a}}">编辑</text></view><view class="tags-container data-v-db2757ab"><view wx:for="{{b}}" wx:for-item="tag" wx:key="b" class="tag-item data-v-db2757ab"><text class="tag-name data-v-db2757ab">{{tag.a}}</text></view><view class="tag-item add data-v-db2757ab" bindtap="{{c}}"><text class="tag-name data-v-db2757ab">+ 添加</text></view></view></view><view class="profile-section data-v-db2757ab"><view class="section-header data-v-db2757ab"><text class="section-title data-v-db2757ab">❤️ 偏好设置</text><text class="section-edit data-v-db2757ab" bindtap="{{d}}">编辑</text></view><view class="preferences-grid data-v-db2757ab"><view class="preference-item data-v-db2757ab"><text class="preference-label data-v-db2757ab">聚会类型</text><view class="preference-value data-v-db2757ab"><text class="value-text data-v-db2757ab">{{e}}</text></view></view><view class="preference-item data-v-db2757ab"><text class="preference-label data-v-db2757ab">活动时间</text><view class="preference-value data-v-db2757ab"><text class="value-text data-v-db2757ab">{{f}}</text></view></view><view class="preference-item data-v-db2757ab"><text class="preference-label data-v-db2757ab">参与人数</text><view class="preference-value data-v-db2757ab"><text class="value-text data-v-db2757ab">{{g}}</text></view></view><view class="preference-item data-v-db2757ab"><text class="preference-label data-v-db2757ab">预算范围</text><view class="preference-value data-v-db2757ab"><text class="value-text data-v-db2757ab">{{h}}</text></view></view></view></view><view class="profile-section data-v-db2757ab"><view class="section-header data-v-db2757ab"><text class="section-title data-v-db2757ab">📊 数据统计</text></view><view class="stats-grid data-v-db2757ab"><view class="stat-card data-v-db2757ab"><text class="stat-icon data-v-db2757ab">🎉</text><text class="stat-value data-v-db2757ab">{{i}}</text><text class="stat-label data-v-db2757ab">参与聚会</text></view><view class="stat-card data-v-db2757ab"><text class="stat-icon data-v-db2757ab">👥</text><text class="stat-value data-v-db2757ab">{{j}}</text><text class="stat-label data-v-db2757ab">认识好友</text></view><view class="stat-card data-v-db2757ab"><text class="stat-icon data-v-db2757ab">💬</text><text class="stat-value data-v-db2757ab">{{k}}</text><text class="stat-label data-v-db2757ab">发表评论</text></view><view class="stat-card data-v-db2757ab"><text class="stat-icon data-v-db2757ab">❤️</text><text class="stat-value data-v-db2757ab">{{l}}</text><text class="stat-label data-v-db2757ab">获得点赞</text></view></view></view><view class="profile-section data-v-db2757ab"><view class="section-header data-v-db2757ab"><text class="section-title data-v-db2757ab">🎯 行为分析</text></view><view class="behavior-list data-v-db2757ab"><view class="behavior-item data-v-db2757ab"><text class="behavior-label data-v-db2757ab">活跃时段</text><view class="behavior-chart data-v-db2757ab"><view wx:for="{{m}}" wx:for-item="value" wx:key="a" class="chart-bar data-v-db2757ab" style="{{'height:' + value.b}}"></view></view></view><view class="behavior-item data-v-db2757ab"><text class="behavior-label data-v-db2757ab">偏好类型</text><view class="preference-chart data-v-db2757ab"><view wx:for="{{n}}" wx:for-item="item" wx:key="b" class="chart-pie data-v-db2757ab" style="{{'background:' + item.c + ';' + ('width:' + item.d)}}"><text class="pie-label data-v-db2757ab">{{item.a}}</text></view></view></view><view class="behavior-item data-v-db2757ab"><text class="behavior-label data-v-db2757ab">参与频率</text><view class="frequency-chart data-v-db2757ab"><view class="frequency-item data-v-db2757ab"><text class="freq-label data-v-db2757ab">本周</text><text class="freq-value data-v-db2757ab">{{o}}次</text></view><view class="frequency-item data-v-db2757ab"><text class="freq-label data-v-db2757ab">本月</text><text class="freq-value data-v-db2757ab">{{p}}次</text></view><view class="frequency-item data-v-db2757ab"><text class="freq-label data-v-db2757ab">总计</text><text class="freq-value data-v-db2757ab">{{q}}次</text></view></view></view></view></view><view class="profile-section data-v-db2757ab"><view class="section-header data-v-db2757ab"><text class="section-title data-v-db2757ab">✨ 智能推荐</text></view><scroll-view class="recommend-scroll data-v-db2757ab" scroll-x><view wx:for="{{r}}" wx:for-item="party" wx:key="d" class="recommend-item data-v-db2757ab" bindtap="{{party.e}}"><image class="recommend-image data-v-db2757ab" src="{{party.a}}" mode="aspectFill"></image><view class="recommend-info data-v-db2757ab"><text class="recommend-title data-v-db2757ab">{{party.b}}</text><text class="recommend-match data-v-db2757ab">匹配度 {{party.c}}%</text></view></view></scroll-view></view><view class="action-section data-v-db2757ab"><button class="action-btn primary data-v-db2757ab" bindtap="{{s}}"><text class="data-v-db2757ab">完善画像</text></button><button class="action-btn secondary data-v-db2757ab" bindtap="{{t}}"><text class="data-v-db2757ab">刷新数据</text></button></view></view>