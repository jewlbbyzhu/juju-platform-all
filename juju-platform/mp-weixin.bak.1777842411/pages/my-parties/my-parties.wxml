<view class="my-parties-container"><view class="nav-header"><view class="nav-left" bindtap="{{a}}"><text class="iconfont icon-arrow-left"></text></view><view class="nav-center"><text class="page-title">我的活动</text></view><view class="nav-right" bindtap="{{b}}"><text class="iconfont icon-plus"></text></view></view><view class="role-tabs"><view class="{{['role-tab', c && 'active']}}" bindtap="{{d}}"><text class="iconfont icon-crown"></text><text>我组织的</text></view><view class="{{['role-tab', e && 'active']}}" bindtap="{{f}}"><text class="iconfont icon-ticket"></text><text>我参与的</text></view></view><view wx:if="{{g}}" class="filter-section"><scroll-view class="filter-scroll" scroll-x show-scrollbar="false"><view class="{{['filter-item', h && 'active']}}" bindtap="{{i}}"><text>全部</text></view><view class="{{['filter-item', j && 'active']}}" bindtap="{{k}}"><text>即将开始</text></view><view class="{{['filter-item', l && 'active']}}" bindtap="{{m}}"><text>进行中</text></view><view class="{{['filter-item', n && 'active']}}" bindtap="{{o}}"><text>已结束</text></view><view class="{{['filter-item', p && 'active']}}" bindtap="{{q}}"><text>已取消</text></view></scroll-view></view><scroll-view class="party-list" scroll-y bindscrolltolower="{{F}}" bindrefresherrefresh="{{G}}" refresher-enabled="{{true}}" refresher-triggered="{{H}}"><view wx:if="{{r}}" class="skeleton-wrapper"><view wx:for="{{s}}" wx:for-item="i" wx:key="a" class="party-skeleton"><view class="skeleton-thumb"/><view class="skeleton-content"><view class="skeleton-line title"/><view class="skeleton-line meta"/></view></view></view><view wx:for="{{t}}" wx:for-item="party" wx:key="C" class="party-card" style="{{'animation-delay:' + party.D}}" bindtap="{{party.E}}"><view class="card-main"><image class="party-thumb" src="{{party.a}}" mode="aspectFill"/><view class="party-info"><view class="info-header"><text class="party-title">{{party.b}}</text><view class="{{['party-status', party.d]}}"><text>{{party.c}}</text></view></view><view class="party-meta"><view class="meta-item"><text class="iconfont icon-calendar"></text><text>{{party.e}}</text></view><view class="meta-item"><text class="iconfont icon-location"></text><text>{{party.f}}</text></view><view class="meta-item"><text class="iconfont icon-people"></text><text>{{party.g}}/{{party.h}}人</text></view></view><view wx:if="{{v}}" class="party-stats"><view class="stat-item"><text class="stat-value">¥{{party.i}}</text><text class="stat-label">总收入</text></view><view class="stat-item"><text class="stat-value">{{party.j}}</text><text class="stat-label">已售票</text></view><view class="stat-item"><text class="stat-value">{{party.k}}</text><text class="stat-label">浏览量</text></view></view><view wx:else class="ticket-info"><text class="ticket-type">{{party.l}}</text><text class="{{['ticket-status', party.n]}}">{{party.m}}</text></view></view></view><view wx:if="{{w}}" class="card-actions"><button wx:if="{{party.o}}" class="action-btn secondary" catchtap="{{party.p}}"><text class="iconfont icon-chart"></text><text>数据</text></button><button wx:if="{{party.q}}" class="action-btn secondary" catchtap="{{party.r}}"><text class="iconfont icon-ticket"></text><text>验票</text></button><button class="action-btn secondary" catchtap="{{party.s}}"><text class="iconfont icon-share"></text><text>分享</text></button><button wx:if="{{party.t}}" class="action-btn primary" catchtap="{{party.v}}"><text>编辑</text></button><button wx:if="{{party.w}}" class="action-btn danger" catchtap="{{party.x}}"><text>取消</text></button></view><view wx:else class="card-actions"><button class="action-btn secondary" catchtap="{{party.y}}"><text class="iconfont icon-ticket"></text><text>查看票券</text></button><button class="action-btn secondary" catchtap="{{party.z}}"><text class="iconfont icon-order"></text><text>订单详情</text></button><button wx:if="{{party.A}}" class="action-btn primary" catchtap="{{party.B}}"><text>进入聚会</text></button></view></view><view wx:if="{{x}}" class="loading-more"><view class="loading-spinner"/><text class="loading-text">加载中...</text></view><view wx:if="{{y}}" class="no-more"><text>没有更多了</text></view><view wx:if="{{z}}" class="empty-state"><image class="empty-icon" src="{{A}}" mode="aspectFit"/><text class="empty-title">{{B}}</text><text class="empty-desc">{{C}}</text><button class="empty-btn" bindtap="{{E}}"><text>{{D}}</text></button></view></scroll-view></view>