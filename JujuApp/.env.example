# JUJU App 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# API 配置
# ============================================
API_BASE_URL=https://api.hfparty.asia/api/v1
API_BASE_URL_V2=https://api.hfparty.asia/api/v2
WS_BASE_URL=wss://api.hfparty.asia
API_TIMEOUT=30000

# ============================================
# 应用配置
# ============================================
APP_NAME=聚聚
APP_VERSION=1.0.4
DEFAULT_PAGE_SIZE=10

# ============================================
# 环境模式 (development | staging | production)
# ============================================
NODE_ENV=development

# ============================================
# 离线模式 (true | false)
# ============================================
OFFLINE_MODE=false

# ============================================
# 第三方服务 API Keys (请替换为实际值)
# ============================================
# 地图服务
MAP_API_KEY=your_map_api_key_here

# 推送服务
PUSH_NOTIFICATION_KEY=your_push_key_here

# 分析服务
ANALYTICS_KEY=your_analytics_key_here

# ============================================
# 功能开关
# ============================================
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PUSH_NOTIFICATION=true
ENABLE_OFFLINE_MODE=true
