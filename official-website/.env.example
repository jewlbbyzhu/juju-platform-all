# ==========================================
# 聚聚官方网站环境变量配置
# JuJu Party Official Website Environment Variables
# ==========================================

# ------------------------------------------
# 后端API配置 / Backend API Configuration
# ------------------------------------------

# 后端基础URL (开发环境默认: http://localhost:3001)
# Backend base URL
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3001

# API版本URL (可选，如不设置则使用默认值)
# API version URLs (optional)
# NEXT_PUBLIC_BACKEND_API_URL_V1=http://localhost:3001/api/v1
# NEXT_PUBLIC_BACKEND_API_URL_V2=http://localhost:3001/api/v2

# ------------------------------------------
# 应用下载链接 / App Download URLs
# ------------------------------------------

# Android应用下载链接
# Android app download URL (APK or Google Play)
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=

# iOS应用下载链接
# iOS app download URL (App Store)
NEXT_PUBLIC_IOS_DOWNLOAD_URL=

# 微信小程序链接
# WeChat Mini Program URL
NEXT_PUBLIC_WECHAT_MINIPROGRAM_URL=

# ------------------------------------------
# 管理后台配置 / Admin Web Configuration
# ------------------------------------------

# 管理后台URL (用于登录后跳转)
# Admin web URL (for post-login redirect)
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:5173

# ------------------------------------------
# 分析统计配置 / Analytics Configuration (可选)
# ------------------------------------------

# Google Analytics 测量ID
# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 百度统计ID
# Baidu Analytics ID
# NEXT_PUBLIC_BAIDU_TONGJI_ID=

# ------------------------------------------
# SEO和元数据 / SEO and Metadata
# ------------------------------------------

# 网站基础URL (用于生成sitemap和canonical链接)
# Site base URL (for sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://juju-party.com

# 默认OG图片URL
# Default Open Graph image URL
# NEXT_PUBLIC_OG_IMAGE_URL=https://juju-party.com/og-default.png

# ------------------------------------------
# 功能开关 / Feature Flags
# ------------------------------------------

# 是否启用登录功能 (true/false)
# Enable login feature
# NEXT_PUBLIC_ENABLE_LOGIN=false

# 是否显示统计数字 (true/false)
# Show statistics numbers
# NEXT_PUBLIC_SHOW_STATS=false
