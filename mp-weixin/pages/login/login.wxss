.login-container {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FF6B35, #FF4081);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 32rpx;
}

.slogan {
  font-size: 28rpx;
  color: #888;
  margin-top: 16rpx;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx 0;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-bottom: 32rpx;
  border: none;
}

.login-btn.wechat {
  background: #07c160;
  color: #fff;
}

.login-btn.phone {
  background: transparent;
  border: 2rpx solid #333;
  color: #fff;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background: #333;
}

.divider-text {
  color: #666;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.login-footer {
  padding-bottom: 60rpx;
}

.agreement {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

.agreement .link {
  color: #FF6B35;
}

/* 手机号登录弹窗 */
.phone-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.phone-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.phone-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  font-size: 40rpx;
  color: #666;
}

.modal-body {
  padding-bottom: 60rpx;
}

.input-item {
  display: flex;
  align-items: center;
  background: #333;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.input-item input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.input-item.verify-code {
  justify-content: space-between;
}

.input-item.verify-code input {
  flex: 1;
}

.send-code-btn {
  background: transparent;
  color: #FF6B35;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.send-code-btn[disabled] {
  color: #666;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 16rpx;
}