<view class="search-container">
  <view class="search-header">
    <view class="search-input-wrap">
      <text class="iconfont icon-search"></text>
      <input 
        class="search-input" 
        placeholder="搜索派对、活动、用户"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{focused}}"
      />
      <text class="iconfont icon-close" bindtap="clearKeyword" wx:if="{{keyword}}"></text>
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>
  
  <view class="search-body">
    <!-- 搜索结果 -->
    <view wx:if="{{keyword && results.length > 0}}" class="results-list">
      <view 
        wx:for="{{results}}" 
        wx:key="id" 
        class="result-item"
        bindtap="onResultTap"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
      >
        <image class="result-cover" src="{{item.cover}}" mode="aspectFill"/>
        <view class="result-info">
          <text class="result-title">{{item.title}}</text>
          <text class="result-meta">{{item.date}} · {{item.location}}</text>
        </view>
      </view>
    </view>
    
    <!-- 无结果 -->
    <view wx:elif="{{keyword && !loading && results.length === 0}}" class="no-results">
      <text class="no-results-text">未找到"{{keyword}}"相关结果</text>
    </view>
    
    <!-- 加载中 -->
    <view wx:elif="{{loading}}" class="loading">
      <text>搜索中...</text>
    </view>
    
    <!-- 搜索历史和热门 -->
    <view wx:else class="history-section">
      <view class="section-header" wx:if="{{history.length > 0}}">
        <text class="section-title">搜索历史</text>
        <text class="clear-history" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-tags" wx:if="{{history.length > 0}}">
        <text 
          wx:for="{{history}}" 
          wx:key="*this" 
          class="history-tag"
          bindtap="onHistoryTap"
          data-keyword="{{item}}"
        >{{item}}</text>
      </view>
      
      <view class="section-header" style="margin-top: 48rpx;">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="history-tags">
        <text 
          wx:for="{{hotSearch}}" 
          wx:key="*this" 
          class="history-tag hot"
          bindtap="onHistoryTap"
          data-keyword="{{item}}"
        >{{item}}</text>
      </view>
    </view>
  </view>
</view>