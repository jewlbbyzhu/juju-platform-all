.search-container {
  min-height: 100vh;
  background: #0a0a0a;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #1a1a1a;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #333;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  margin-left: 16rpx;
}

.cancel-btn {
  color: #FF6B35;
  font-size: 28rpx;
  margin-left: 24rpx;
}

.search-body {
  padding: 32rpx;
}

.results-list {
  display: flex;
  flex-direction: column;
}

.result-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #222;
}

.result-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #333;
}

.result-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.result-title {
  font-size: 32rpx;
  color: #fff;
}

.result-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.no-results-text {
  font-size: 28rpx;
  color: #666;
}

.loading {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
  font-size: 28rpx;
  color: #666;
}

.history-section {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.clear-history {
  font-size: 24rpx;
  color: #888;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
}

.history-tag {
  padding: 12rpx 24rpx;
  background: #222;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #aaa;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.history-tag.hot {
  background: rgba(255, 107, 53, 0.2);
  color: #FF6B35;
}